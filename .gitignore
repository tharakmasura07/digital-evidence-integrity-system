# =============================================================================
# Digital Evidence Integrity System (DEIS) — .gitignore
# =============================================================================

# Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Editor & IDE Directories
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak
scratch/

# Node & Package Managers (if initialized in future)
node_modules/

# Local Environment Variables & Secrets
.env
.env.local
.env.*.local
